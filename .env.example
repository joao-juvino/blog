# Local PostgreSQL
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=choose-a-local-password

# Spring Boot / production database (Supabase pooler recommended)
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.PROJECT_REF
DATABASE_PASSWORD=replace-me

# Generate at least 32 random bytes; never reuse this example
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://your-site.onrender.com

# First administrator (created only when the e-mail does not exist)
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Supabase Storage (backend only; never expose service key in Angular)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=blog-images
